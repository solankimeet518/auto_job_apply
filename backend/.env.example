# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma

# Indeed Credentials (Optional, can be prompted at runtime)
INDEED_USERNAME=
INDEED_PASSWORD=

# Playwright Browser Automation Configuration
# Set to 'false' to watch the browser work, or 'true' for background execution
HEADLESS=false

# Job Search & Apply Settings
RESUME_PATH=
TARGET_JOB="Software Engineer"
TARGET_LOCATION="Remote"
